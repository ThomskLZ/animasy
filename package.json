{
  "name": "animasy",
  "version": "0.1.0",
  "description": "Veja e ajuste animações de personagens 3D. Fácil, mas sem teto.",
  "license": "MIT",
  "author": {
    "name": "ThomskLZ"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thomsklz.animasy",
    "productName": "Animasy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Animasy-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Animasy-Portatil-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "Animasy-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "Animasy-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ThomskLZ",
        "repo": "animasy",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/ThomskLZ/animasy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomskLZ/animasy.git"
  },
  "bugs": {
    "url": "https://github.com/ThomskLZ/animasy/issues"
  },
  "keywords": [
    "animation",
    "gltf",
    "glb",
    "3d",
    "rigging",
    "electron",
    "threejs"
  ]
}
